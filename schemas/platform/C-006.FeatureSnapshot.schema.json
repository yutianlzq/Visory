{
  "$defs": {
    "FeaturePartitionRef": {
      "additionalProperties": false,
      "properties": {
        "definition_version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Definition Version",
          "type": "string"
        },
        "feature_partition_id": {
          "title": "Feature Partition Id",
          "type": "string"
        },
        "indicator_id": {
          "title": "Indicator Id",
          "type": "string"
        },
        "partition_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Partition Hash",
          "type": "string"
        },
        "required_columns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Columns",
          "type": "array"
        },
        "retention_class": {
          "$ref": "#/$defs/RetentionClass",
          "default": "REBUILDABLE"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Schema Hash",
          "type": "string"
        },
        "storage_ref": {
          "$ref": "#/$defs/StorageRef"
        }
      },
      "required": [
        "feature_partition_id",
        "partition_hash",
        "schema_hash",
        "revision",
        "storage_ref",
        "indicator_id",
        "definition_version"
      ],
      "title": "FeaturePartitionRef",
      "type": "object"
    },
    "FeatureSnapshotType": {
      "enum": [
        "CLOSE_CORE",
        "LATE_A_SHARE",
        "CORRECTION",
        "HISTORICAL_REBUILD"
      ],
      "title": "FeatureSnapshotType",
      "type": "string"
    },
    "PublicationStatus": {
      "enum": [
        "DRAFT",
        "PROVISIONAL",
        "CERTIFIED",
        "RETIRED"
      ],
      "title": "PublicationStatus",
      "type": "string"
    },
    "QualityStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "FAILED",
        "UNAVAILABLE",
        "STALE"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "RetentionClass": {
      "enum": [
        "PINNED",
        "AUDIT",
        "REBUILDABLE",
        "CACHE",
        "TEMP",
        "QUARANTINE"
      ],
      "title": "RetentionClass",
      "type": "string"
    },
    "RevisionKind": {
      "enum": [
        "INITIAL",
        "CORRECTION",
        "REBUILD",
        "MIGRATION"
      ],
      "title": "RevisionKind",
      "type": "string"
    },
    "StorageBackend": {
      "enum": [
        "local_fs"
      ],
      "title": "StorageBackend",
      "type": "string"
    },
    "StorageNamespace": {
      "enum": [
        "app"
      ],
      "title": "StorageNamespace",
      "type": "string"
    },
    "StorageRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "storage_backend": {
          "$ref": "#/$defs/StorageBackend"
        },
        "storage_namespace": {
          "$ref": "#/$defs/StorageNamespace"
        }
      },
      "required": [
        "storage_backend",
        "storage_namespace",
        "relative_path",
        "content_hash",
        "media_type",
        "size_bytes"
      ],
      "title": "StorageRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of_trade_date": {
      "format": "date",
      "title": "As Of Trade Date",
      "type": "string"
    },
    "certified_capabilities": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Certified Capabilities",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cutoff_at": {
      "format": "date-time",
      "title": "Cutoff At",
      "type": "string"
    },
    "data_snapshot_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Data Snapshot Ids",
      "type": "array"
    },
    "definition_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Definition Refs",
      "type": "array"
    },
    "dependency_plan_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Dependency Plan Hash",
      "type": "string"
    },
    "feature_partition_refs": {
      "items": {
        "$ref": "#/$defs/FeaturePartitionRef"
      },
      "minItems": 1,
      "title": "Feature Partition Refs",
      "type": "array"
    },
    "feature_snapshot_id": {
      "title": "Feature Snapshot Id",
      "type": "string"
    },
    "manifest_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Hash",
      "type": "string"
    },
    "manifest_version": {
      "default": "1.0.0",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Manifest Version",
      "type": "string"
    },
    "max_source_available_at": {
      "format": "date-time",
      "title": "Max Source Available At",
      "type": "string"
    },
    "missing_capabilities": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Missing Capabilities",
      "type": "array"
    },
    "publication_status": {
      "$ref": "#/$defs/PublicationStatus"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "quality_report_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality Report Id"
    },
    "quality_status": {
      "$ref": "#/$defs/QualityStatus"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "revision_kind": {
      "$ref": "#/$defs/RevisionKind",
      "default": "INITIAL"
    },
    "snapshot_type": {
      "$ref": "#/$defs/FeatureSnapshotType"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    }
  },
  "required": [
    "feature_snapshot_id",
    "snapshot_type",
    "as_of_trade_date",
    "cutoff_at",
    "data_snapshot_ids",
    "feature_partition_refs",
    "dependency_plan_hash",
    "definition_refs",
    "publication_status",
    "quality_status",
    "max_source_available_at",
    "revision",
    "manifest_hash",
    "created_at"
  ],
  "title": "FeatureSnapshot",
  "type": "object"
}
