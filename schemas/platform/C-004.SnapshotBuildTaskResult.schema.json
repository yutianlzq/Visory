{
  "$defs": {
    "CapabilityCertification": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "capability_status": {
          "$ref": "#/$defs/SnapshotCapabilityStatus"
        },
        "certified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certified At"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Id"
        }
      },
      "required": [
        "capability_id",
        "capability_status"
      ],
      "title": "CapabilityCertification",
      "type": "object"
    },
    "ConsumerRequirementStatus": {
      "enum": [
        "ACCEPTED",
        "REJECTED"
      ],
      "title": "ConsumerRequirementStatus",
      "type": "string"
    },
    "DataSnapshot": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "calendar_ref": {
          "title": "Calendar Ref",
          "type": "string"
        },
        "canonical_partitions": {
          "items": {
            "$ref": "#/$defs/SnapshotPartitionRef"
          },
          "title": "Canonical Partitions",
          "type": "array"
        },
        "certified_capabilities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Certified Capabilities",
          "type": "array"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "cutoff_at": {
          "format": "date-time",
          "title": "Cutoff At",
          "type": "string"
        },
        "manifest_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Hash",
          "type": "string"
        },
        "manifest_version": {
          "default": "1.0.0",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Manifest Version",
          "type": "string"
        },
        "missing_capabilities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Capabilities",
          "type": "array"
        },
        "provider_policy_id": {
          "title": "Provider Policy Id",
          "type": "string"
        },
        "provider_policy_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Provider Policy Version",
          "type": "string"
        },
        "publication_status": {
          "$ref": "#/$defs/SnapshotPublicationStatus"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "quality_report_refs": {
          "items": {
            "type": "string"
          },
          "title": "Quality Report Refs",
          "type": "array"
        },
        "quality_status": {
          "$ref": "#/$defs/QualityStatus"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "revision_kind": {
          "$ref": "#/$defs/RevisionKind",
          "default": "INITIAL"
        },
        "security_master_ref": {
          "title": "Security Master Ref",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "supersedes_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Id"
        },
        "trade_date": {
          "format": "date",
          "title": "Trade Date",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "trade_date",
        "cutoff_at",
        "provider_policy_id",
        "provider_policy_version",
        "security_master_ref",
        "calendar_ref",
        "canonical_partitions",
        "quality_report_refs",
        "quality_status",
        "publication_status",
        "revision",
        "available_at",
        "created_at",
        "manifest_hash",
        "content_hash"
      ],
      "title": "DataSnapshot",
      "type": "object"
    },
    "QualityStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "FAILED",
        "UNAVAILABLE",
        "STALE"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "RevisionKind": {
      "enum": [
        "INITIAL",
        "CORRECTION",
        "REBUILD",
        "MIGRATION"
      ],
      "title": "RevisionKind",
      "type": "string"
    },
    "SnapshotCapabilityStatus": {
      "enum": [
        "CERTIFIED",
        "UNAVAILABLE",
        "DEGRADED",
        "UNVERIFIED"
      ],
      "title": "SnapshotCapabilityStatus",
      "type": "string"
    },
    "SnapshotPartitionRef": {
      "additionalProperties": false,
      "properties": {
        "canonical_partition_id": {
          "title": "Canonical Partition Id",
          "type": "string"
        },
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_schema_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Dataset Schema Version",
          "type": "string"
        },
        "max_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Available At"
        },
        "min_available_at": {
          "format": "date-time",
          "title": "Min Available At",
          "type": "string"
        },
        "partition_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Partition Hash",
          "type": "string"
        },
        "partition_key": {
          "title": "Partition Key",
          "type": "string"
        },
        "provider_policy_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Provider Policy Version",
          "type": "string"
        },
        "provider_run_refs": {
          "items": {
            "type": "string"
          },
          "title": "Provider Run Refs",
          "type": "array"
        },
        "quality_report_id": {
          "title": "Quality Report Id",
          "type": "string"
        },
        "quality_status": {
          "$ref": "#/$defs/QualityStatus"
        },
        "raw_object_refs": {
          "items": {
            "type": "string"
          },
          "title": "Raw Object Refs",
          "type": "array"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "revision_kind": {
          "$ref": "#/$defs/RevisionKind",
          "default": "INITIAL"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "schema_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Schema Hash",
          "type": "string"
        },
        "storage_ref": {
          "$ref": "#/$defs/StorageRef"
        }
      },
      "required": [
        "canonical_partition_id",
        "dataset_id",
        "dataset_schema_version",
        "provider_policy_version",
        "partition_key",
        "revision",
        "storage_ref",
        "partition_hash",
        "schema_hash",
        "quality_report_id",
        "quality_status",
        "provider_run_refs",
        "raw_object_refs",
        "min_available_at",
        "row_count"
      ],
      "title": "SnapshotPartitionRef",
      "type": "object"
    },
    "SnapshotPublicationStatus": {
      "enum": [
        "PROVISIONAL",
        "CERTIFIED",
        "REJECTED"
      ],
      "title": "SnapshotPublicationStatus",
      "type": "string"
    },
    "StorageBackend": {
      "enum": [
        "local_fs"
      ],
      "title": "StorageBackend",
      "type": "string"
    },
    "StorageNamespace": {
      "enum": [
        "app"
      ],
      "title": "StorageNamespace",
      "type": "string"
    },
    "StorageRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "storage_backend": {
          "$ref": "#/$defs/StorageBackend"
        },
        "storage_namespace": {
          "$ref": "#/$defs/StorageNamespace"
        }
      },
      "required": [
        "storage_backend",
        "storage_namespace",
        "relative_path",
        "content_hash",
        "media_type",
        "size_bytes"
      ],
      "title": "StorageRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "capability_certifications": {
      "items": {
        "$ref": "#/$defs/CapabilityCertification"
      },
      "title": "Capability Certifications",
      "type": "array"
    },
    "failure_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "published": {
      "title": "Published",
      "type": "boolean"
    },
    "requirement_status": {
      "$ref": "#/$defs/ConsumerRequirementStatus",
      "default": "ACCEPTED"
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/DataSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "attempt_id",
    "capability_certifications",
    "published"
  ],
  "title": "SnapshotBuildTaskResult",
  "type": "object"
}
