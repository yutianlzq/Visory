    },
    "alias_value": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Alias Value",
      "type": "string"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "entity_key": {
      "title": "Entity Key",
      "type": "string"
    },
    "namespace": {
      "maxLength": 128,
      "title": "Namespace",
      "type": "string"
    },
    "normalized_value": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Normalized Value",
      "type": "string"
    },
    "revision": {
