{
  "$defs": {
    "QualityStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "FAILED",
        "UNAVAILABLE",
        "STALE"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "RetentionClass": {
      "enum": [
        "PINNED",
        "AUDIT",
        "REBUILDABLE",
        "CACHE",
        "TEMP",
        "QUARANTINE"
      ],
      "title": "RetentionClass",
      "type": "string"
    },
    "RevisionKind": {
      "enum": [
        "INITIAL",
        "CORRECTION",
        "REBUILD",
        "MIGRATION"
      ],
      "title": "RevisionKind",
      "type": "string"
    },
    "StorageBackend": {
      "enum": [
        "local_fs"
      ],
      "title": "StorageBackend",
      "type": "string"
    },
    "StorageNamespace": {
      "enum": [
        "app"
      ],
      "title": "StorageNamespace",
      "type": "string"
    },
    "StorageRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "storage_backend": {
          "$ref": "#/$defs/StorageBackend"
        },
        "storage_namespace": {
          "$ref": "#/$defs/StorageNamespace"
        }
      },
      "required": [
        "storage_backend",
        "storage_namespace",
        "relative_path",
        "content_hash",
        "media_type",
        "size_bytes"
      ],
      "title": "StorageRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverage_ratio": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Coverage Ratio"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cutoff_at": {
      "format": "date-time",
      "title": "Cutoff At",
      "type": "string"
    },
    "data_snapshot_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Data Snapshot Ids",
      "type": "array"
    },
    "definition_version": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Definition Version",
      "type": "string"
    },
    "domain": {
      "title": "Domain",
      "type": "string"
    },
    "feature_partition_id": {
      "title": "Feature Partition Id",
      "type": "string"
    },
    "frequency": {
      "title": "Frequency",
      "type": "string"
    },
    "indicator_id": {
      "title": "Indicator Id",
      "type": "string"
    },
    "input_partition_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Input Partition Ids",
      "type": "array"
    },
    "max_available_at": {
      "format": "date-time",
      "title": "Max Available At",
      "type": "string"
    },
    "max_date": {
      "format": "date",
      "title": "Max Date",
      "type": "string"
    },
    "min_available_at": {
      "format": "date-time",
      "title": "Min Available At",
      "type": "string"
    },
    "min_date": {
      "format": "date",
      "title": "Min Date",
      "type": "string"
    },
    "null_count": {
      "minimum": 0,
      "title": "Null Count",
      "type": "integer"
    },
    "partition_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Partition Hash",
      "type": "string"
    },
    "partition_key": {
      "title": "Partition Key",
      "type": "string"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "quality_failure_reasons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Quality Failure Reasons",
      "type": "array"
    },
    "quality_report_id": {
      "title": "Quality Report Id",
      "type": "string"
    },
    "quality_status": {
      "$ref": "#/$defs/QualityStatus"
    },
    "reference_count": {
      "default": 0,
      "minimum": 0,
      "title": "Reference Count",
      "type": "integer"
    },
    "retention_class": {
      "$ref": "#/$defs/RetentionClass",
      "default": "REBUILDABLE"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "revision_kind": {
      "$ref": "#/$defs/RevisionKind",
      "default": "INITIAL"
    },
    "row_count": {
      "minimum": 0,
      "title": "Row Count",
      "type": "integer"
    },
    "schema_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Schema Hash",
      "type": "string"
    },
    "storage_ref": {
      "$ref": "#/$defs/StorageRef"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "universe_scope_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Universe Scope Hash"
    }
  },
  "required": [
    "feature_partition_id",
    "indicator_id",
    "definition_version",
    "domain",
    "frequency",
    "partition_key",
    "data_snapshot_ids",
    "cutoff_at",
    "row_count",
    "null_count",
    "coverage_ratio",
    "min_date",
    "max_date",
    "min_available_at",
    "max_available_at",
    "storage_ref",
    "partition_hash",
    "schema_hash",
    "quality_status",
    "quality_report_id",
    "revision",
    "created_at"
  ],
  "title": "FeaturePartition",
  "type": "object"
}
