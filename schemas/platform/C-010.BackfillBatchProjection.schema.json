    "skipped_ranges": {
      "default": [],
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "format": "date",
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Skipped Ranges",
      "type": "array"
