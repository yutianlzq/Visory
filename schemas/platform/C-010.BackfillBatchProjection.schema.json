{
  "$defs": {
    "BackfillBatchType": {
      "enum": [
        "MONTH",
        "YEAR"
      ],
      "title": "BackfillBatchType",
      "type": "string"
    },
    "BackfillPublicationEvidence": {
      "additionalProperties": false,
      "description": "Fixed publication evidence; a published fixture never proves historical coverage.",
      "properties": {
        "canonical_manifest_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Canonical Manifest Hash",
          "type": "string"
        },
        "canonical_partition_id": {
          "title": "Canonical Partition Id",
          "type": "string"
        },
        "canonical_storage_ref": {
          "$ref": "#/$defs/StorageRef"
        },
        "coverage_state": {
          "const": "PUBLISHED_UNCERTIFIED",
          "default": "PUBLISHED_UNCERTIFIED",
          "title": "Coverage State",
          "type": "string"
        },
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_schema_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Dataset Schema Version",
          "type": "string"
        },
        "date_from": {
          "format": "date",
          "title": "Date From",
          "type": "string"
        },
        "date_to": {
          "format": "date",
          "title": "Date To",
          "type": "string"
        },
        "failed_provider_run_hashes": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Failed Provider Run Hashes",
          "type": "object"
        },
        "mapping_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Mapping Hash",
          "type": "string"
        },
        "mapping_version": {
          "title": "Mapping Version",
          "type": "string"
        },
        "provider_policy_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Provider Policy Version",
          "type": "string"
        },
        "provider_run_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Provider Run Hash",
          "type": "string"
        },
        "provider_run_id": {
          "title": "Provider Run Id",
          "type": "string"
        },
        "quality_report_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Quality Report Hash",
          "type": "string"
        },
        "quality_report_id": {
          "title": "Quality Report Id",
          "type": "string"
        },
        "raw_manifest_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Raw Manifest Hash",
          "type": "string"
        },
        "raw_object_id": {
          "title": "Raw Object Id",
          "type": "string"
        },
        "raw_storage_ref": {
          "$ref": "#/$defs/StorageRef"
        },
        "row_count": {
          "exclusiveMinimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "snapshot_file_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Snapshot File Hash",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "snapshot_manifest_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Snapshot Manifest Hash",
          "type": "string"
        }
      },
      "required": [
        "date_from",
        "date_to",
        "dataset_id",
        "dataset_schema_version",
        "provider_policy_version",
        "provider_run_id",
        "raw_object_id",
        "canonical_partition_id",
        "quality_report_id",
        "snapshot_id",
        "provider_run_hash",
        "quality_report_hash",
        "raw_storage_ref",
        "canonical_storage_ref",
        "raw_manifest_hash",
        "canonical_manifest_hash",
        "snapshot_manifest_hash",
        "snapshot_file_hash",
        "mapping_version",
        "mapping_hash",
        "row_count"
      ],
      "title": "BackfillPublicationEvidence",
      "type": "object"
    },
    "BackfillQuarantineEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_storage_ref": {
          "$ref": "#/$defs/StorageRef"
        },
        "failed_provider_run_hashes": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Failed Provider Run Hashes",
          "type": "object"
        },
        "manifest_file_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest File Hash",
          "type": "string"
        },
        "provider_run_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Provider Run Hash",
          "type": "string"
        },
        "provider_run_id": {
          "title": "Provider Run Id",
          "type": "string"
        },
        "raw_ingestion_quarantine_id": {
          "title": "Raw Ingestion Quarantine Id",
          "type": "string"
        },
        "reason_code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,79}$",
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "provider_run_id",
        "raw_ingestion_quarantine_id",
        "provider_run_hash",
        "evidence_storage_ref",
        "manifest_file_hash",
        "reason_code"
      ],
      "title": "BackfillQuarantineEvidence",
      "type": "object"
    },
    "BackfillRejectionEvidence": {
      "additionalProperties": false,
      "description": "Fixed inputs and diagnosis for a child that refused business publication.",
      "properties": {
        "batch_id": {
          "title": "Batch Id",
          "type": "string"
        },
        "canonical_manifest_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Manifest Hash"
        },
        "canonical_partition_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Partition Id"
        },
        "canonical_storage_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/StorageRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "canonical_task_id": {
          "title": "Canonical Task Id",
          "type": "string"
        },
        "child_attempt_id": {
          "title": "Child Attempt Id",
          "type": "string"
        },
        "child_input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Child Input Hash",
          "type": "string"
        },
        "child_task_id": {
          "title": "Child Task Id",
          "type": "string"
        },
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "date_from": {
          "format": "date",
          "title": "Date From",
          "type": "string"
        },
        "date_to": {
          "format": "date",
          "title": "Date To",
          "type": "string"
        },
        "failed_provider_run_hashes": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Failed Provider Run Hashes",
          "type": "object"
        },
        "failure_code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,79}$",
          "title": "Failure Code",
          "type": "string"
        },
        "parent_task_id": {
          "title": "Parent Task Id",
          "type": "string"
        },
        "phase": {
          "enum": [
            "CANONICAL",
            "SNAPSHOT"
          ],
          "title": "Phase",
          "type": "string"
        },
        "provider_run_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Provider Run Hash",
          "type": "string"
        },
        "provider_run_id": {
          "title": "Provider Run Id",
          "type": "string"
        },
        "quality_report_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Quality Report Hash",
          "type": "string"
        },
        "quality_report_id": {
          "title": "Quality Report Id",
          "type": "string"
        },
        "raw_manifest_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Raw Manifest Hash",
          "type": "string"
        },
        "raw_object_id": {
          "title": "Raw Object Id",
          "type": "string"
        },
        "raw_storage_ref": {
          "$ref": "#/$defs/StorageRef"
        }
      },
      "required": [
        "date_from",
        "date_to",
        "dataset_id",
        "batch_id",
        "parent_task_id",
        "phase",
        "child_task_id",
        "child_attempt_id",
        "child_input_hash",
        "canonical_task_id",
        "failure_code",
        "provider_run_id",
        "provider_run_hash",
        "raw_object_id",
        "raw_storage_ref",
        "raw_manifest_hash",
        "quality_report_id",
        "quality_report_hash"
      ],
      "title": "BackfillRejectionEvidence",
      "type": "object"
    },
    "BackfillStage": {
      "enum": [
        "IDENTITY_CALENDAR",
        "PRICE_MONTH",
        "LIFECYCLE_NAMES",
        "CORPORATE_ACTION",
        "FINANCIAL_VALUATION",
        "INDUSTRY_MEMBERS",
        "NON_CORE_OBSERVATION"
      ],
      "title": "BackfillStage",
      "type": "string"
    },
    "BackfillStatus": {
      "enum": [
        "PLANNED",
        "RUNNING",
        "PAUSED",
        "PARTIAL",
        "FAILED",
        "CANCELLED",
        "COMPLETED",
        "UNAVAILABLE",
        "QUARANTINED"
      ],
      "title": "BackfillStatus",
      "type": "string"
    },
    "StorageBackend": {
      "enum": [
        "local_fs"
      ],
      "title": "StorageBackend",
      "type": "string"
    },
    "StorageNamespace": {
      "enum": [
        "app"
      ],
      "title": "StorageNamespace",
      "type": "string"
    },
    "StorageRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "storage_backend": {
          "$ref": "#/$defs/StorageBackend"
        },
        "storage_namespace": {
          "$ref": "#/$defs/StorageNamespace"
        }
      },
      "required": [
        "storage_backend",
        "storage_namespace",
        "relative_path",
        "content_hash",
        "media_type",
        "size_bytes"
      ],
      "title": "StorageRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "title": "Batch Id",
      "type": "string"
    },
    "batch_state": {
      "$ref": "#/$defs/BackfillStatus"
    },
    "batch_type": {
      "$ref": "#/$defs/BackfillBatchType"
    },
    "blocked_reason_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Blocked Reason Code"
    },
    "canonical_partition_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Canonical Partition Refs",
      "type": "array"
    },
    "checkpoint_phase": {
      "title": "Checkpoint Phase",
      "type": "string"
    },
    "completed_range": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed Range"
    },
    "coverage_state": {
      "const": "UNPROVEN",
      "default": "UNPROVEN",
      "title": "Coverage State",
      "type": "string"
    },
    "dataset": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Dataset",
      "type": "string"
    },
    "date_from": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date From"
    },
    "date_to": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date To"
    },
    "dependency_task_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Dependency Task Ids",
      "type": "array"
    },
    "differences_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Differences Summary"
    },
    "dry_run": {
      "title": "Dry Run",
      "type": "boolean"
    },
    "failed_range": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failed Range"
    },
    "failed_ranges": {
      "default": [],
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "format": "date",
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Failed Ranges",
      "type": "array"
    },
    "failure_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "gap_ranges": {
      "default": [],
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "format": "date",
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Gap Ranges",
      "type": "array"
    },
    "plan_only": {
      "title": "Plan Only",
      "type": "boolean"
    },
    "priority": {
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "provider_fallback": {
      "default": false,
      "title": "Provider Fallback",
      "type": "boolean"
    },
    "provider_policy_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Provider Policy Id",
      "type": "string"
    },
    "provider_run_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Provider Run Refs",
      "type": "array"
    },
    "publication_evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BackfillPublicationEvidence"
      },
      "title": "Publication Evidence",
      "type": "array"
    },
    "quality_events": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Quality Events",
      "type": "array"
    },
    "quarantine_evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BackfillQuarantineEvidence"
      },
      "title": "Quarantine Evidence",
      "type": "array"
    },
    "raw_object_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Raw Object Refs",
      "type": "array"
    },
    "rejection_evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BackfillRejectionEvidence"
      },
      "title": "Rejection Evidence",
      "type": "array"
    },
    "resource_usage": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Resource Usage",
      "type": "object"
    },
    "retry_plan": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Retry Plan",
      "type": "array"
    },
    "skipped_range": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skipped Range"
    },
    "skipped_ranges": {
      "default": [],
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "format": "date",
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Skipped Ranges",
      "type": "array"
    },
    "snapshot_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Snapshot Refs",
      "type": "array"
    },
    "stage": {
      "$ref": "#/$defs/BackfillStage"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "trade_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trade Date"
    },
    "unblock_condition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unblock Condition"
    }
  },
  "required": [
    "batch_id",
    "task_id",
    "batch_state",
    "batch_type",
    "stage",
    "dataset",
    "provider_policy_id",
    "priority",
    "dry_run",
    "plan_only",
    "checkpoint_phase"
  ],
  "title": "BackfillBatchProjection",
  "type": "object"
}
