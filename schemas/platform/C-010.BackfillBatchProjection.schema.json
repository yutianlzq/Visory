{
  "$defs": {
    "BackfillBatchType": {
      "enum": [
        "MONTH",
        "YEAR"
      ],
      "title": "BackfillBatchType",
      "type": "string"
    },
    "BackfillStage": {
      "enum": [
        "IDENTITY_CALENDAR",
        "PRICE_MONTH",
        "LIFECYCLE_NAMES",
        "CORPORATE_ACTION",
        "FINANCIAL_VALUATION",
        "INDUSTRY_MEMBERS",
        "NON_CORE_OBSERVATION"
      ],
      "title": "BackfillStage",
      "type": "string"
    },
    "BackfillStatus": {
      "enum": [
        "PLANNED",
        "RUNNING",
        "PAUSED",
        "PARTIAL",
        "FAILED",
        "CANCELLED",
        "COMPLETED",
        "UNAVAILABLE",
        "QUARANTINED"
      ],
      "title": "BackfillStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
