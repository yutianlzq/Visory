    "skipped_range": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skipped Range"
