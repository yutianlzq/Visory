      "default": "SOURCE_PUBLISHED_LE_AVAILABLE_LE_CUTOFF_NO_BACKFILL",
      "title": "Pit Policy",
      "type": "string"
    },
    "precision": {
      "default": 38,
      "title": "Precision",
      "type": "integer"
    },
    "price_source": {
      "const": "PINNED_RAW_CLOSE_PREVIOUS_SESSION_NO_FILL",
      "default": "PINNED_RAW_CLOSE_PREVIOUS_SESSION_NO_FILL",
      "title": "Price Source",
      "type": "string"
    },
    "return_semantics": {
      "const": "PRICE_CONTINUITY_NOT_TOTAL_RETURN",
      "default": "PRICE_CONTINUITY_NOT_TOTAL_RETURN",
      "title": "Return Semantics",
      "type": "string"
    },
    "revision_policy": {
      "const": "HIGHEST_KNOWN_IN_PINNED_INPUT_RETAIN_CANCELLED_EVIDENCE",
      "default": "HIGHEST_KNOWN_IN_PINNED_INPUT_RETAIN_CANCELLED_EVIDENCE",
      "title": "Revision Policy",
      "type": "string"
    },
    "rounding": {
      "const": "ROUND_HALF_EVEN",
      "default": "ROUND_HALF_EVEN",
      "title": "Rounding",
      "type": "string"
    },
    "same_day_policy": {
      "const": "ONE_CONFIRMED_GROUP_COMMON_OLD_SHARE_BASIS",
      "default": "ONE_CONFIRMED_GROUP_COMMON_OLD_SHARE_BASIS",
      "title": "Same Day Policy",
      "type": "string"
    },
    "split_formula": {
      "const": "Q=P/s;q=Q/P",
      "default": "Q=P/s;q=Q/P",
      "title": "Split Formula",
      "type": "string"
    },
    "split_unit": {
      "const": "POST_SHARES_OVER_PRE_SHARES_GT_ONE",
      "default": "POST_SHARES_OVER_PRE_SHARES_GT_ONE",
      "title": "Split Unit",
      "type": "string"
    }
