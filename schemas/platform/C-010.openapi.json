{
  "components": {
    "schemas": {
      "AliasType": {
        "enum": [
          "PROVIDER_SYMBOL",
          "BARE_CODE",
          "EXCHANGE_CODE",
          "ISIN",
          "CURRENT_NAME",
          "HISTORICAL_NAME",
          "PINYIN",
          "USER_ALIAS"
        ],
        "title": "AliasType",
        "type": "string"
      },
      "AssetResolutionCandidate": {
        "additionalProperties": false,
        "properties": {
          "alias_type": {
            "$ref": "#/components/schemas/AliasType"
          },
          "asset_type": {
            "$ref": "#/components/schemas/AssetType"
          },
          "canonical_id": {
            "title": "Canonical Id",
            "type": "string"
          },
          "entity_key": {
            "title": "Entity Key",
            "type": "string"
          },
          "identity_status": {
            "$ref": "#/components/schemas/IdentityStatus"
          },
          "matched_value": {
            "title": "Matched Value",
            "type": "string"
          },
          "namespace": {
            "maxLength": 128,
            "title": "Namespace",
            "type": "string"
          }
        },
        "required": [
          "asset_type",
          "canonical_id",
          "entity_key",
          "alias_type",
          "namespace",
          "matched_value",
          "identity_status"
        ],
        "title": "AssetResolutionCandidate",
        "type": "object"
      },
      "AssetResolutionRequest": {
        "additionalProperties": false,
        "properties": {
          "allow_inactive": {
            "default": false,
            "title": "Allow Inactive",
            "type": "boolean"
          },
          "asset_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AssetType"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "input_namespace": {
            "maxLength": 128,
            "title": "Input Namespace",
            "type": "string"
          },
          "input_value": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Input Value",
            "type": "string"
          }
        },
        "required": [
          "input_namespace",
          "input_value"
        ],
        "title": "AssetResolutionRequest",
        "type": "object"
      },
      "AssetResolutionResult": {
        "additionalProperties": false,
        "properties": {
          "asset_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AssetType"
              },
              {
                "type": "null"
              }
            ]
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/AssetResolutionCandidate"
            },
            "title": "Candidates",
            "type": "array"
          },
          "canonical_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Canonical Id"
          },
          "entity_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entity Key"
          },
          "reason_codes": {
            "items": {
              "type": "string"
            },
            "title": "Reason Codes",
            "type": "array"
          },
          "resolution_status": {
            "$ref": "#/components/schemas/ResolutionStatus"
          },
          "resolved_at": {
            "format": "date-time",
            "title": "Resolved At",
            "type": "string"
          },
          "resolver_version": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "title": "Resolver Version",
            "type": "string"
          }
        },
        "required": [
          "asset_type",
          "canonical_id",
          "entity_key",
          "resolution_status",
          "candidates",
          "reason_codes",
          "resolver_version",
          "resolved_at"
        ],
        "title": "AssetResolutionResult",
        "type": "object"
      },
      "AssetType": {
        "enum": [
          "stock",
          "index",
          "etf",
          "convertible_bond",
          "fund",
          "future",
          "fx",
          "commodity"
        ],
        "title": "AssetType",
        "type": "string"
      },
      "IdentityStatus": {
        "enum": [
          "ACTIVE",
          "INACTIVE",
          "DELISTED",
          "QUARANTINED"
        ],
        "title": "IdentityStatus",
        "type": "string"
      },
      "PlatformAPIError": {
        "additionalProperties": false,
        "description": "Stable public error fields required by C-010.",
        "properties": {
          "code": {
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "pattern": "^req_[0-9a-f]{32}$",
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "retryable",
          "request_id"
        ],
        "title": "PlatformAPIError",
        "type": "object"
      },
      "PlatformErrorEnvelope": {
        "additionalProperties": false,
        "description": "C-010 error response.",
        "examples": [
          {
            "error": {
              "code": "RESOURCE_NOT_FOUND",
              "details": {},
              "message": "资源不存在",
              "request_id": "req_0123456789abcdef0123456789abcdef",
              "retryable": false
            }
          }
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/PlatformAPIError"
          }
        },
        "required": [
          "error"
        ],
        "title": "PlatformErrorEnvelope",
        "type": "object"
      },
      "PlatformListEnvelope": {
        "additionalProperties": false,
        "description": "C-010 list success response with opaque cursor metadata.",
        "examples": [
          {
            "data": [
              {
                "resource_id": "example"
              }
            ],
            "meta": {
              "data_snapshot_id": null,
              "generated_at": "2026-08-27T12:00:00+08:00",
              "request_id": "req_0123456789abcdef0123456789abcdef",
              "schema_version": "1.0.0",
              "warnings": []
            },
            "page": {
              "cursor": null,
              "has_more": false,
              "limit": 50,
              "next_cursor": null
            }
          }
        ],
        "properties": {
          "data": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Data",
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/PlatformResponseMeta"
          },
          "page": {
            "$ref": "#/components/schemas/PlatformPage"
          }
        },
        "required": [
          "data",
          "meta",
          "page"
        ],
        "title": "PlatformListEnvelope",
        "type": "object"
      },
      "PlatformPage": {
        "additionalProperties": false,
        "description": "Opaque cursor metadata for C-010 list responses.",
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor"
          },
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "limit": {
            "maximum": 1000,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "cursor",
          "next_cursor",
          "limit",
          "has_more"
        ],
        "title": "PlatformPage",
        "type": "object"
      },
      "PlatformResponseMeta": {
        "additionalProperties": false,
        "description": "C-010 metadata shared by all successful platform responses.",
        "properties": {
          "data_snapshot_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Snapshot Id"
          },
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "request_id": {
            "pattern": "^req_[0-9a-f]{32}$",
            "title": "Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "request_id",
          "schema_version",
          "generated_at",
          "data_snapshot_id",
          "warnings"
        ],
        "title": "PlatformResponseMeta",
        "type": "object"
      },
      "PlatformSuccessEnvelope": {
        "additionalProperties": false,
        "description": "C-010 object success response.",
        "examples": [
          {
            "data": {
              "resource_id": "example"
            },
            "meta": {
              "data_snapshot_id": null,
              "generated_at": "2026-08-27T12:00:00+08:00",
              "request_id": "req_0123456789abcdef0123456789abcdef",
              "schema_version": "1.0.0",
              "warnings": []
            }
          }
        ],
        "properties": {
          "data": {
            "additionalProperties": true,
            "title": "Data",
            "type": "object"
          },
          "meta": {
            "$ref": "#/components/schemas/PlatformResponseMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "PlatformSuccessEnvelope",
        "type": "object"
      },
      "ResolutionStatus": {
        "enum": [
          "RESOLVED",
          "AMBIGUOUS",
          "NOT_FOUND",
          "UNSUPPORTED",
          "CONFLICT",
          "INACTIVE"
        ],
        "title": "ResolutionStatus",
        "type": "string"
      }
    }
  },
  "info": {
    "description": "C-010 public response components. Runtime resources are added by later Work Packages under /api/platform/v1; Legacy /api/v1 responses are not wrapped.",
    "title": "Visory Platform API Contracts",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/platform/v1/asset-resolutions": {
      "post": {
        "operationId": "resolveAssetIdentity",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssetResolutionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformSuccessEnvelope"
                }
              }
            },
            "description": "C-002 resolution result wrapped by C-010"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformErrorEnvelope"
                }
              }
            },
            "description": "Invalid request"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformErrorEnvelope"
                }
              }
            },
            "description": "Identity repository unavailable"
          }
        },
        "summary": "Resolve an asset identity without guessing"
      }
    }
  }
}
