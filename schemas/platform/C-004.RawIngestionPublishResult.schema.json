{
  "$defs": {
    "ProviderRun": {
      "additionalProperties": false,
      "properties": {
        "actual_upstream": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Upstream"
        },
        "adapter_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Adapter Version",
          "type": "string"
        },
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "byte_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Count"
        },
        "capability_frequency": {
          "title": "Capability Frequency",
          "type": "string"
        },
        "capability_market": {
          "title": "Capability Market",
          "type": "string"
        },
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_schema_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Dataset Schema Version",
          "type": "string"
        },
        "failure_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        },
        "failure_detail_redacted": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Detail Redacted"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "observed_schema_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Schema Hash"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "provider_policy_id": {
          "title": "Provider Policy Id",
          "type": "string"
        },
        "provider_policy_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Provider Policy Version",
          "type": "string"
        },
        "provider_run_id": {
          "title": "Provider Run Id",
          "type": "string"
        },
        "raw_object_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Raw Object Refs",
          "type": "array"
        },
        "request_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Fingerprint",
          "type": "string"
        },
        "row_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Count"
        },
        "run_outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRunOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "provider_run_id",
        "provider_id",
        "dataset_id",
        "dataset_schema_version",
        "provider_policy_id",
        "provider_policy_version",
        "adapter_version",
        "capability_market",
        "capability_frequency",
        "task_id",
        "attempt_id",
        "request_fingerprint",
        "started_at"
      ],
      "title": "ProviderRun",
      "type": "object"
    },
    "ProviderRunOutcome": {
      "enum": [
        "SUCCEEDED",
        "DEGRADED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "ProviderRunOutcome",
      "type": "string"
    },
    "QuarantineStatus": {
      "enum": [
        "OPEN",
        "RESOLVED",
        "REJECTED"
      ],
      "title": "QuarantineStatus",
      "type": "string"
    },
    "RawCompression": {
      "enum": [
        "NONE",
        "GZIP"
      ],
      "title": "RawCompression",
      "type": "string"
    },
    "RawIngestionQuarantine": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "$ref": "#/$defs/RawSchemaDriftClassification"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        },
        "evidence_storage_ref": {
          "$ref": "#/$defs/StorageRef"
        },
        "expected_schema_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Expected Schema Hash",
          "type": "string"
        },
        "failure_detail_redacted": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Detail Redacted"
        },
        "observed_schema_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Schema Hash"
        },
        "provider_run_id": {
          "title": "Provider Run Id",
          "type": "string"
        },
        "quarantine_status": {
          "$ref": "#/$defs/QuarantineStatus",
          "default": "OPEN"
        },
        "raw_ingestion_quarantine_id": {
          "title": "Raw Ingestion Quarantine Id",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "raw_ingestion_quarantine_id",
        "provider_run_id",
        "classification",
        "reason_code",
        "expected_schema_hash",
        "evidence_storage_ref",
        "evidence_hash",
        "created_at"
      ],
      "title": "RawIngestionQuarantine",
      "type": "object"
    },
    "RawObject": {
      "additionalProperties": false,
      "properties": {
        "actual_upstream": {
          "title": "Actual Upstream",
          "type": "string"
        },
        "byte_count": {
          "minimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "compression": {
          "$ref": "#/$defs/RawCompression"
        },
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_schema_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Dataset Schema Version",
          "type": "string"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "observed_schema_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Observed Schema Hash",
          "type": "string"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "provider_run_id": {
          "title": "Provider Run Id",
          "type": "string"
        },
        "provider_schema_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Provider Schema Version",
          "type": "string"
        },
        "raw_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Raw Content Hash",
          "type": "string"
        },
        "raw_object_id": {
          "title": "Raw Object Id",
          "type": "string"
        },
        "request_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Fingerprint",
          "type": "string"
        },
        "retention_class": {
          "$ref": "#/$defs/RetentionClass",
          "default": "PINNED"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "source_published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Published At"
        },
        "storage_ref": {
          "$ref": "#/$defs/StorageRef"
        }
      },
      "required": [
        "raw_object_id",
        "provider_run_id",
        "provider_id",
        "actual_upstream",
        "dataset_id",
        "dataset_schema_version",
        "request_fingerprint",
        "storage_ref",
        "raw_content_hash",
        "media_type",
        "compression",
        "observed_at",
        "ingested_at",
        "provider_schema_version",
        "observed_schema_hash",
        "row_count",
        "byte_count"
      ],
      "title": "RawObject",
      "type": "object"
    },
    "RawSchemaDriftClassification": {
      "enum": [
        "MATCHED",
        "ADDITIVE_DRIFT",
        "BREAKING_DRIFT",
        "UNKNOWN_SCHEMA"
      ],
      "title": "RawSchemaDriftClassification",
      "type": "string"
    },
    "RetentionClass": {
      "enum": [
        "PINNED",
        "AUDIT",
        "REBUILDABLE",
        "CACHE",
        "TEMP",
        "QUARANTINE"
      ],
      "title": "RetentionClass",
      "type": "string"
    },
    "StorageBackend": {
      "enum": [
        "local_fs"
      ],
      "title": "StorageBackend",
      "type": "string"
    },
    "StorageNamespace": {
      "enum": [
        "app"
      ],
      "title": "StorageNamespace",
      "type": "string"
    },
    "StorageRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "storage_backend": {
          "$ref": "#/$defs/StorageBackend"
        },
        "storage_namespace": {
          "$ref": "#/$defs/StorageNamespace"
        }
      },
      "required": [
        "storage_backend",
        "storage_namespace",
        "relative_path",
        "content_hash",
        "media_type",
        "size_bytes"
      ],
      "title": "StorageRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "provider_run": {
      "$ref": "#/$defs/ProviderRun"
    },
    "quarantine": {
      "anyOf": [
        {
          "$ref": "#/$defs/RawIngestionQuarantine"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "raw_object": {
      "anyOf": [
        {
          "$ref": "#/$defs/RawObject"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "provider_run"
  ],
  "title": "RawIngestionPublishResult",
  "type": "object"
}
