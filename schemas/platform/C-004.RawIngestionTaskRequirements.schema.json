{
  "additionalProperties": false,
  "description": "Secret-free durable task input for one controlled raw-provider request.",
  "properties": {
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Dataset Schema Version",
      "type": "string"
    },
    "market": {
      "default": "CN",
      "title": "Market",
      "type": "string"
    },
    "provider_id": {
      "title": "Provider Id",
      "type": "string"
    },
    "provider_policy_id": {
      "title": "Provider Policy Id",
      "type": "string"
    },
    "request": {
      "additionalProperties": true,
      "title": "Request",
      "type": "object"
    },
    "timeout_seconds": {
      "default": 30,
      "maximum": 300,
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    }
  },
  "required": [
    "provider_id",
    "dataset_id",
    "dataset_schema_version",
    "provider_policy_id"
  ],
  "title": "RawIngestionTaskRequirements",
  "type": "object"
}
