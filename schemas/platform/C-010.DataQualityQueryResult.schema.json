        "dataset_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Dataset Ids",
          "type": "array"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "provider_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Provider Ids",
          "type": "array"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
