{
  "$defs": {
    "ArtifactIntegrityState": {
      "enum": [
        "VERIFIED",
        "MISSING",
        "HASH_MISMATCH",
        "SIZE_MISMATCH",
        "MANIFEST_INVALID"
      ],
      "title": "ArtifactIntegrityState",
      "type": "string"
    },
    "ArtifactPublicationState": {
      "enum": [
        "PUBLISHED"
      ],
      "title": "ArtifactPublicationState",
      "type": "string"
    },
    "StorageBackend": {
      "enum": [
        "local_fs"
      ],
      "title": "StorageBackend",
      "type": "string"
    },
    "StorageNamespace": {
      "enum": [
        "app"
      ],
      "title": "StorageNamespace",
      "type": "string"
    },
    "StorageRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "storage_backend": {
          "$ref": "#/$defs/StorageBackend"
        },
        "storage_namespace": {
          "$ref": "#/$defs/StorageNamespace"
        }
      },
      "required": [
        "storage_backend",
        "storage_namespace",
        "relative_path",
        "content_hash",
        "media_type",
        "size_bytes"
      ],
      "title": "StorageRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artifact Hash",
      "type": "string"
    },
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "integrity_state": {
      "$ref": "#/$defs/ArtifactIntegrityState"
    },
    "manifest_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Hash",
      "type": "string"
    },
    "publication_state": {
      "$ref": "#/$defs/ArtifactPublicationState"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "storage_ref": {
      "$ref": "#/$defs/StorageRef"
    }
  },
  "required": [
    "artifact_id",
    "storage_ref",
    "artifact_hash",
    "manifest_hash",
    "publication_state",
    "integrity_state",
    "published_at"
  ],
  "title": "ArtifactPublishResult",
  "type": "object"
}
