{
  "$defs": {
    "PriorityClass": {
      "enum": [
        "P0_DATA_CERTIFICATION",
        "P1_FORMAL_SIGNAL",
        "P2_MARKET_REVIEW",
        "P3_USER_INTERACTIVE",
        "P4_RESEARCH",
        "P5_PREVIEW_AND_MAINTENANCE"
      ],
      "title": "PriorityClass",
      "type": "string"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "title": "Resource Id",
          "type": "string"
        },
        "resource_type": {
          "$ref": "#/$defs/ResourceType"
        }
      },
      "required": [
        "resource_type",
        "resource_id"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "ResourceType": {
      "enum": [
        "task",
        "attempt",
        "data_snapshot",
        "feature_snapshot",
        "observation_snapshot",
        "fact_pack",
        "research",
        "review",
        "strategy",
        "backtest_run",
        "prediction",
        "artifact",
        "report",
        "provider_run",
        "sector",
        "taxonomy",
        "indicator",
        "raw_object",
        "canonical_partition",
        "feature_partition",
        "fact_block",
        "claim",
        "watch_condition",
        "quality_report",
        "request",
        "checkpoint",
        "backup",
        "deployment"
      ],
      "title": "ResourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_from_task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created From Task Id"
    },
    "force": {
      "default": false,
      "title": "Force",
      "type": "boolean"
    },
    "force_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Force Reason"
    },
    "input_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResourceRef"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "max_attempts": {
      "default": 3,
      "maximum": 100,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "priority_class": {
      "$ref": "#/$defs/PriorityClass",
      "default": "P5_PREVIEW_AND_MAINTENANCE"
    },
    "priority_value": {
      "default": 100,
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Priority Value",
      "type": "integer"
    },
    "request_source": {
      "default": "platform_api",
      "maxLength": 64,
      "minLength": 1,
      "title": "Request Source",
      "type": "string"
    },
    "requested_by": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Requested By",
      "type": "string"
    },
    "requirements": {
      "additionalProperties": true,
      "title": "Requirements",
      "type": "object"
    },
    "task_schema_version": {
      "default": "1.0.0",
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Task Schema Version",
      "type": "string"
    },
    "task_type": {
      "const": "artifact_orphan_dry_run",
      "title": "Task Type",
      "type": "string"
    }
  },
  "required": [
    "task_type",
    "requested_by"
  ],
  "title": "TaskCreateRequest",
  "type": "object"
}
