{
  "$defs": {
    "ProviderRunOutcome": {
      "enum": [
        "SUCCEEDED",
        "DEGRADED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "ProviderRunOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actual_upstream": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual Upstream"
    },
    "adapter_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Adapter Version",
      "type": "string"
    },
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "byte_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Byte Count"
    },
    "capability_frequency": {
      "title": "Capability Frequency",
      "type": "string"
    },
    "capability_market": {
      "title": "Capability Market",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Dataset Schema Version",
      "type": "string"
    },
    "failure_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "failure_detail_redacted": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Detail Redacted"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "observed_schema_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Schema Hash"
    },
    "provider_id": {
      "title": "Provider Id",
      "type": "string"
    },
    "provider_policy_id": {
      "title": "Provider Policy Id",
      "type": "string"
    },
    "provider_policy_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Provider Policy Version",
      "type": "string"
    },
    "provider_run_id": {
      "title": "Provider Run Id",
      "type": "string"
    },
    "raw_object_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Raw Object Refs",
      "type": "array"
    },
    "request_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "row_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Row Count"
    },
    "run_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderRunOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "provider_run_id",
    "provider_id",
    "dataset_id",
    "dataset_schema_version",
    "provider_policy_id",
    "provider_policy_version",
    "adapter_version",
    "capability_market",
    "capability_frequency",
    "task_id",
    "attempt_id",
    "request_fingerprint",
    "started_at"
  ],
  "title": "ProviderRun",
  "type": "object"
}
