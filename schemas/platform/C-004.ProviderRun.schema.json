{
  "$defs": {
    "ProviderRunOutcome": {
      "enum": [
        "SUCCEEDED",
        "DEGRADED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "ProviderRunOutcome",
      "type": "string"
    },
    "ProviderSourceEvidenceState": {
      "enum": [
        "PROVEN",
        "UNPROVEN",
        "FAILED",
        "NOT_APPLICABLE"
      ],
      "title": "ProviderSourceEvidenceState",
      "type": "string"
    },
    "ProviderSourceExecutionState": {
      "enum": [
        "AVAILABLE",
        "BLOCKED",
        "UNAVAILABLE",
        "FIXTURE_ONLY"
      ],
      "title": "ProviderSourceExecutionState",
      "type": "string"
    },
    "ProviderSourceKind": {
      "enum": [
        "HTTP",
        "TCP",
        "SDK",
        "FILE",
        "FIXTURE"
      ],
      "title": "ProviderSourceKind",
      "type": "string"
    },
    "ProviderSourceRouteEvidence": {
      "additionalProperties": false,
      "description": "Immutable binding from a controlled adapter to its real upstream source.",
      "properties": {
        "actual_upstream": {
          "title": "Actual Upstream",
          "type": "string"
        },
        "adapter_blob": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Adapter Blob",
          "type": "string"
        },
        "adapter_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Adapter Commit",
          "type": "string"
        },
        "adapter_entrypoint": {
          "title": "Adapter Entrypoint",
          "type": "string"
        },
        "adapter_name": {
          "title": "Adapter Name",
          "type": "string"
        },
        "adapter_release": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Adapter Release",
          "type": "string"
        },
        "adapter_repository": {
          "title": "Adapter Repository",
          "type": "string"
        },
        "adapter_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Adapter Version",
          "type": "string"
        },
        "coverage_evidence_state": {
          "$ref": "#/$defs/ProviderSourceEvidenceState"
        },
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "documented_history_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Documented History Start"
        },
        "execution_state": {
          "$ref": "#/$defs/ProviderSourceExecutionState"
        },
        "license_blob": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "License Blob",
          "type": "string"
        },
        "license_id": {
          "title": "License Id",
          "type": "string"
        },
        "market": {
          "title": "Market",
          "type": "string"
        },
        "pagination_evidence_state": {
          "$ref": "#/$defs/ProviderSourceEvidenceState"
        },
        "pit_evidence_state": {
          "$ref": "#/$defs/ProviderSourceEvidenceState"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "revision_evidence_state": {
          "$ref": "#/$defs/ProviderSourceEvidenceState"
        },
        "source_kind": {
          "$ref": "#/$defs/ProviderSourceKind"
        },
        "source_route_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Route Hash",
          "type": "string"
        },
        "source_route_id": {
          "title": "Source Route Id",
          "type": "string"
        },
        "unavailable_reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason Code"
        }
      },
      "required": [
        "source_route_id",
        "provider_id",
        "dataset_id",
        "adapter_name",
        "adapter_version",
        "adapter_repository",
        "adapter_release",
        "adapter_commit",
        "adapter_blob",
        "adapter_entrypoint",
        "actual_upstream",
        "source_kind",
        "market",
        "coverage_evidence_state",
        "pit_evidence_state",
        "pagination_evidence_state",
        "revision_evidence_state",
        "execution_state",
        "license_id",
        "license_blob",
        "source_route_hash"
      ],
      "title": "ProviderSourceRouteEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actual_upstream": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual Upstream"
    },
    "adapter_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Adapter Version",
      "type": "string"
    },
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "byte_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Byte Count"
    },
    "capability_frequency": {
      "title": "Capability Frequency",
      "type": "string"
    },
    "capability_market": {
      "title": "Capability Market",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Dataset Schema Version",
      "type": "string"
    },
    "failure_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "failure_detail_redacted": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Detail Redacted"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "observed_schema_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Schema Hash"
    },
    "provider_id": {
      "title": "Provider Id",
      "type": "string"
    },
    "provider_policy_id": {
      "title": "Provider Policy Id",
      "type": "string"
    },
    "provider_policy_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Provider Policy Version",
      "type": "string"
    },
    "provider_run_id": {
      "title": "Provider Run Id",
      "type": "string"
    },
    "raw_object_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Raw Object Refs",
      "type": "array"
    },
    "request_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "row_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Row Count"
    },
    "run_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderRunOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_route_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderSourceRouteEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "provider_run_id",
    "provider_id",
    "dataset_id",
    "dataset_schema_version",
    "provider_policy_id",
    "provider_policy_version",
    "adapter_version",
    "capability_market",
    "capability_frequency",
    "task_id",
    "attempt_id",
    "request_fingerprint",
    "started_at"
  ],
  "title": "ProviderRun",
  "type": "object"
}
